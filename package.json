{
  "name": "credlet-clients",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js && node extension/build-v3.mjs",
    "build:client": "vite build --config client/vite.config.js",
    "build:server": "cmake -S server -B server/build-v3 -DCMAKE_BUILD_TYPE=Release && cmake --build server/build-v3 --parallel",
    "tauri": "tauri",
    "test": "node --test client/test/*.test.js extension/test/passkeys.test.mjs",
    "test:legacy": "node --test extension/test/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "hash-wasm": "4.12.0",
    "svelte": "5.57.2",
    "tldts": "7.4.19",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "esbuild": "0.28.2",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
